#!/bin/sh /etc/rc.common
# init.d/lp104mqtt — script de arranque OpenWrt/procd (OPCIONAL, no instalado por defecto)
#
# Instalación manual:
#   cp init.d/lp104mqtt /etc/init.d/lp104mqtt && chmod +x /etc/init.d/lp104mqtt
#   /etc/init.d/lp104mqtt enable && /etc/init.d/lp104mqtt start
#
# Nota: el binario se instala en /usr/local/bin/lp104mqtt (overlay rw
# persistente en RUT200), la misma ruta que usa PROG. /tmp es volátil
# (tmpfs) y NO es destino de instalación. `make install` despliega ahí.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/local/bin/lp104mqtt

start_service() {
    [ -x "$PROG" ] || {
        logger -t lp104mqtt "binario no encontrado o no ejecutable: $PROG"
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

stop_service() {
    logger -t lp104mqtt "deteniendo lp104mqtt"
}
